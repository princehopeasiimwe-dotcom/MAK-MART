# ============================================================
# MAK MART - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# ============================================================

# ------------------------------------------------------------------
# SUPABASE (Database, Auth, Realtime)
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ------------------------------------------------------------------
# CLOUDFLARE R2 (File Storage - 10GB Free)
# ------------------------------------------------------------------
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Create an API token with "Object Read & Write" permissions
VITE_R2_ACCOUNT_ID=your-account-id
VITE_R2_ACCESS_KEY_ID=your-access-key-id
VITE_R2_SECRET_ACCESS_KEY=your-secret-access-key
VITE_R2_BUCKET_NAME=mak-mart

# Optional: Custom domain for public R2 URLs (e.g., cdn.yourdomain.com)
# Set up in Cloudflare: R2 > Bucket > Settings > Custom Domain
VITE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ------------------------------------------------------------------
# STORAGE PROVIDER
# ------------------------------------------------------------------
# Set to 'r2' to use Cloudflare R2, 'supabase' for Supabase Storage
VITE_STORAGE_PROVIDER=r2

# ------------------------------------------------------------------
# OPTIONAL: BACKEND API URL (for presigned URLs)
# ------------------------------------------------------------------
# If you deploy the presign/delete endpoints separately
# VITE_API_URL=https://your-api-domain.com

# ------------------------------------------------------------------
# OTHER SERVICES
# ------------------------------------------------------------------
# VITE_WHATSAPP_NUMBER=256XXXXXXXXX
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx